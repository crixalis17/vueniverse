{
  "rule": [
    {
      "action": {"type": "Delete"},
      "condition": {"age": 3, "matchesPrefix": ["staging/"]}
    },
    {
      "action": {"type": "Delete"},
      "condition": {"age": 14, "matchesPrefix": ["checkpoints/"]}
    },
    {
      "action": {"type": "Delete"},
      "condition": {"age": 90, "matchesPrefix": ["datasets/", "adapters/", "reports/", "configs/"]}
    }
  ]
}
